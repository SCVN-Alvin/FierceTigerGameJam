# Normalize text files across Windows, macOS, and Linux.
* text=auto

*.cs text eol=lf diff=csharp
*.cginc text eol=lf
*.compute text eol=lf
*.hlsl text eol=lf
*.shader text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Unity YAML assets should remain text for useful diffs.
*.anim text eol=lf
*.asset text eol=lf
*.controller text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.playable text eol=lf
*.prefab text eol=lf
*.preset text eol=lf
*.unity text eol=lf

# Common binary assets.
*.aif binary
*.aiff binary
*.bmp binary
*.dll binary
*.exr binary
*.fbx binary
*.gif binary
*.jpeg binary
*.jpg binary
*.mp3 binary
*.mp4 binary
*.ogg binary
*.otf binary
*.pdf binary
*.png binary
*.psb binary
*.psd binary
*.so binary
*.tga binary
*.tif binary
*.tiff binary
*.ttf binary
*.wav binary
*.webm binary
